{
  "name": "@cutout/agent",
  "tasks": {
    "setup": "brew bundle"
  },
  "exports": {
    ".": "./app/run.ts",
    "./tools": "./libraries/tools/module.ts",
    "./tasks": "./libraries/tasks/module.ts",
    "./processes": "./libraries/processes/module.ts"
  },
  "imports": {
    "@std/cli/spinner": "jsr:@std/cli/unstable-spinner",
    "@std/streams": "jsr:@std/streams",

    // To ensure "internal" stays so, we alias it here.
    "@cutout/internal": "../../internal/module.ts",
    "@cutout/agent/tools": "./libraries/tools/module.ts",
    "@cutout/agent/processes": "./libraries/processes/module.ts",
    "@cutout/agent/tasks": "./libraries/tasks/module.ts"
  }
}
