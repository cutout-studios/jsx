{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@cutout/jsx",
    "lib": ["deno.ns", "deno.unstable"]
  },
  "exports": {
    "./browser": "./components/browser/module.ts",
    "./components": "./components/module.ts",
    "./errors": "./errors/module.ts",
    "./format/dom/jsx-runtime": "./formats/dom/runtime.d.ts",
    "./format/html/jsx-runtime": "./formats/html/runtime.d.ts",
    "./formats": "./formats/module.ts"
  },
  "imports": {
    // To ensure "internal" stays private, we alias it here.
    "@cutout/internal": "../internal/module.ts",
    "@cutout/internal/polyfill": "../internal/polyfill.ts",
  
    "@std/assert": "jsr:@std/assert",
    "@std/fmt": "jsr:@std/fmt",
    "@std/http/route": "jsr:@std/http/unstable-route",
    "@std/media-types": "jsr:@std/media-types",
    "@std/path": "jsr:@std/path",
    "@std/testing": "jsr:@std/testing",
    // Deno's recommended headless browser "@b-fuze/deno-dom"
    // is a fast but incomplete implementation:
    // "happy-dom" is a complete implementation that more
    // accurately reflects browser overhead.
    "happy-dom": "npm:happy-dom",
    "react": "npm:react",
    "react-dom": "npm:react-dom"
  },
  "license": "MIT",
  "name": "@cutout/web",
  "tasks": {
    "docs:lint": "deno doc --lint ./errors/module.ts ./formats/module.ts ./components/module.ts ./components/browser/module.ts"
  },
  "version": "0.0.0-alpha.0"
}
