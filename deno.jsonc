{
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "license": "MIT",
  "lint": {
    "plugins": [
      "jsr:@ayk/lint-import-order"
    ]
  },
  "tasks": {
    "docs:lint": "deno doc --lint common/module.ts jsx/tokens/module.ts jsx/module.ts",
    "chat": "./chat/run"
  },
  "workspace": [
    "common",
    "chat",
    "jsx",
    "web",
    "elements",
    "tauri"
  ],
  "imports": {
    "cssom": "npm:cssom@^0.5.0"
  }
}
